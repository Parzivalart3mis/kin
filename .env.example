# Neon Postgres — pooled connection string from the Neon dashboard
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/kin?sslmode=require

# Clerk — https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Web Push — generate a pair with `pnpm vapid:generate`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BXxx
VAPID_PRIVATE_KEY=xxx
VAPID_SUBJECT=mailto:you@example.com

# Upstash Redis — https://console.upstash.com → REST API
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx

# Vercel Cron — any long random string; Vercel sends it as `Authorization: Bearer <CRON_SECRET>`
CRON_SECRET=change-me

# Sentry (optional — leave blank to disable)
NEXT_PUBLIC_SENTRY_DSN=

# Seed script only (optional): attach the demo people to your own Clerk user
# SEED_CLERK_USER_ID=user_xxx
# SEED_TIMEZONE=America/Chicago
